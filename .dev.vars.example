# Copier en .dev.vars (jamais commite) pour tester en local avec `npm run dev`.
# En prod, ces valeurs sont des secrets Cloudflare (wrangler secret put ...), pas des vars.

PRONOTE_MALICK_URL=https://xxxxx.index-education.net/pronote/eleve.html?login=true
PRONOTE_MALICK_USERNAME=identifiant.malick
PRONOTE_MALICK_PASSWORD=motdepasse

PRONOTE_CODOU_URL=https://xxxxx.index-education.net/pronote/eleve.html?login=true
PRONOTE_CODOU_USERNAME=identifiant.codou
PRONOTE_CODOU_PASSWORD=motdepasse

# Obligatoire pour que /parent reponde (sinon toujours 403) : header x-parent-token
# (recommande) ou ?token=... (pratique sur telephone, mais visible dans l'historique
# du navigateur et les logs serveur).
PARENT_ACCESS_TOKEN=
